{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "excludeFiles": "{fire_detection_system,saved_incidents,database,.playwright-cli,public/assets}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/saved_incidents/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|saved_incidents/).*)",
      "destination": "/index.html"
    }
  ]
}
